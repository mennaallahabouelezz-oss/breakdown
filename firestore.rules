rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // البلاغات: أي جهاز دخل تلقائيًا (Anonymous) يستطيع القراءة والكتابة
    match /breakdowns/{id} {
      allow read, write: if request.auth != null;
    }

    // كشف السيارات (العملاء): الكل يقرأ، والكتابة لحساب الإدارة فقط
    match /settings/{id} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.token.email == 'admin@radytrans.app';
    }

    // المستخدمون وأكواد الدخول:
    //  - get (قراءة مستند واحد) مسموح عند الدخول لأن المستند رقمه هو بصمة الكود
    //  - list (عرض كل المستخدمين) والكتابة والحذف لحساب الإدارة فقط
    match /appUsers/{id} {
      allow get: if request.auth != null;
      allow list, create, update, delete: if request.auth != null
                   && request.auth.token.email == 'admin@radytrans.app';
    }
  }
}
