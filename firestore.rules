rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // البلاغات: أي جهاز دخل تلقائيًا (Anonymous) يستطيع القراءة والكتابة
    match /breakdowns/{id} {
      allow read, write: if request.auth != null;
    }

    // كشف السيارات (العملاء): الكل يقرأ، والكتابة لحساب الإدارة فقط
    match /settings/{id} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.token.email == 'admin@radytrans.app';
    }
  }
}
